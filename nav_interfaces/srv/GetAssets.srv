# 读取当前地图的全部资产（合并原 get_all_nav_points / get_all_areas / get_all_rooms / get_all_routes / get_route_graph）。
# 只读；未加载地图时 success=false + E_ASSET_NO_MAP。
# 资产类型位掩码（可组合）。kinds = 0 或 KIND_ALL 表示全部。
uint8 KIND_POINTS    = 1
uint8 KIND_AREAS     = 2
uint8 KIND_ROOMS     = 4
uint8 KIND_ROUTES    = 8
uint8 KIND_JUNCTIONS = 16
uint8 KIND_EDGES     = 32
uint8 KIND_ALL       = 63

uint8 kinds     # 要读取的类型位掩码；未请求的类型对应数组为空。0 = 全部（兼容旧调用 {}）
---
bool   success
int32  error_code
string message
string map_name
uint64 map_epoch                      # 与 map_state.epoch 同源，供 SetAssets.expected_epoch 乐观锁
nav_interfaces/NavPoint[]      points
nav_interfaces/AreaInfo[]      areas
nav_interfaces/RoomInfo[]      rooms
nav_interfaces/Route[]         routes
nav_interfaces/RouteJunction[] junctions
nav_interfaces/RouteEdge[]     edges
