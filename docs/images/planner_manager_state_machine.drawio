  <diagram id="planner-manager-state-machine" name="PlannerManager 状态机">
    <mxGraphModel dx="1000" dy="560" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
